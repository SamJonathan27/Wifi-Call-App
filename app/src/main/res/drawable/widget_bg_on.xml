<?xml version="1.0" encoding="utf-8"?>
<!-- Frosted glass: translucent colour tint + light sheen + bright hairline edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#7A1B8A3C" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#38FFFFFF" android:centerColor="#0DFFFFFF" android:endColor="#05FFFFFF" />
            <stroke android:width="1dp" android:color="#66FFFFFF" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
